# ── LinkPulse (Node API) environment ──────────────────────────────
# Copy to server/.env for local development:  cp .env.example server/.env
# Never commit a real .env file.

# PostgreSQL connection string (local Postgres, Neon, Supabase Postgres, Render Postgres, …)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkpulse
# Set to true for hosted databases that require TLS (Neon, Supabase, Render external URL)
DATABASE_SSL=false

# Port the API listens on
PORT=4000
# Public base URL that short codes are appended to (your deployed domain in production)
SHORT_BASE_URL=http://localhost:4000
# Origin of the web app (dev: Vite on 5173; production: same as SHORT_BASE_URL)
APP_ORIGIN=http://localhost:5173

# Sessions
SESSION_TTL_DAYS=14
# true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# bcrypt cost factor for account and link passwords (12 recommended; tests use 4)
BCRYPT_COST=12
# Number of reverse proxies in front of the app (Render/Railway/Fly: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=false

# ── Safety ──
# Optional: Google Safe Browsing v4 API key (https://developers.google.com/safe-browsing/v4/get-started)
# Leave empty to disable; links are then labelled "URL format valid" (reputation not checked).
GOOGLE_SAFE_BROWSING_API_KEY=
# Comma-separated domains to block (subdomains are blocked too). Rows in the blocked_domains table also apply.
BLOCKLIST_DOMAINS=

# Production only: set to false to skip running migrations on start
# RUN_MIGRATIONS_ON_START=true
